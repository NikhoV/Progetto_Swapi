<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Progetto2.Views.DetailViews.FilmDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Progetto2.Views.DetailViews"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="2000" HorizontalAlignment="Left">

            <Grid HorizontalAlignment="Stretch">
                <Button x:Name="BackButton" Content="← Torna alla lista" Click="BackButton_Click" VerticalAlignment="Center"/>

                <!-- Bottone Salva Offline inserito in alto a destra -->
                <Button x:Name="BtnSalvaOffline" 
                        Click="BtnSalvaOffline_Click" 
                        HorizontalAlignment="Right" 
                        Background="#FFE81F" 
                        Foreground="Black" 
                        CornerRadius="8" 
                        Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" Foreground="Black"/>
                        <TextBlock Text="Salva Offline" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- INFOBAR PER CONFERMA SALVATAGGIO -->
            <InfoBar x:Name="InfoBarNotifica" 
                     Severity="Success" 
                     Title="Archiviato!" 
                     Message="Film salvato con successo nel database offline." 
                     IsOpen="False" 
                     Margin="0,-12,0,0"/>

            <Grid ColumnSpacing="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="TitleTextBlock" FontSize="32" FontWeight="Bold" Foreground="#FFE81F" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EpisodeTextBlock" FontSize="16" Foreground="Gray"/>
                        <TextBlock x:Name="DirectorProducerTextBlock" FontSize="14" Foreground="#CCCCCC"/>
                        <TextBlock x:Name="ReleaseDateTextBlock" FontSize="14" Foreground="#CCCCCC"/>
                    </StackPanel>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Esplora le Categorie del Film" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>

                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card / Bottone Navicelle -->
                            <Button Grid.Column="0" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            Padding="20" 
                            Background="#1F1F1F" 
                            CornerRadius="12" 
                            Click="NavicelleCategory_Click">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE709;" FontSize="36" Foreground="#FFE81F"/>
                                    <TextBlock Text="Navicelle" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="NavicelleCountText" Text="0 elementi" Foreground="Gray" FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Card / Bottone Veicoli -->
                            <Button Grid.Column="1" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            Padding="20" 
                            Background="#1F1F1F" 
                            CornerRadius="12" 
                            Click="VeicoliCategory_Click">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xEA86;" FontSize="36" Foreground="#FFE81F"/>
                                    <TextBlock Text="Veicoli" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="VeicoliCountText" Text="0 elementi" Foreground="Gray" FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Card / Bottone Personaggi -->
                            <Button Grid.Column="2" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            Padding="20" 
                            Background="#1F1F1F" 
                            CornerRadius="12" 
                            Click="PersonaggiCategory_Click">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE77B;" FontSize="36" Foreground="#FFE81F"/>
                                    <TextBlock Text="Personaggi" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PersonaggiCountText" Text="0 elementi" Foreground="Gray" FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Card / Bottone Pianeti -->
                            <Button Grid.Column="3"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Padding="20"
                                    Background="#1F1F1F"
                                    CornerRadius="12"
                                    Click="PianetiCategory_Click">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE80F;" FontSize="36" Foreground="#FFE81F"/>
                                    <TextBlock Text="Pianeti" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PianetiCountText" Text="0 elementi" Foreground="Gray" FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <Border Background="#1A1A1A" Padding="18" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Grid.Column="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="OPENING CRAWL" FontWeight="Bold" Foreground="#FFE81F" FontSize="12"/>
                        <TextBlock x:Name="CrawlTextBlock" TextWrapping="Wrap" FontStyle="Italic" FontSize="15" LineHeight="22"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel> 
    </ScrollViewer>
</Page>