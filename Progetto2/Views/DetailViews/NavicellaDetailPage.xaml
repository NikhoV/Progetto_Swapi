<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Progetto2.Views.DetailViews.NavicellaDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Progetto2.Views.DetailViews"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="2000" HorizontalAlignment="Left">

            <Grid HorizontalAlignment="Stretch">
                <Button x:Name="BackButton" Content="← Torna alla lista" Click="BackButton_Click" VerticalAlignment="Center"/>

                <!-- Bottone Salva Offline inserito in alto a destra -->
                <Button x:Name="BtnSalvaOffline" 
                        Click="BtnSalvaOffline_Click" 
                        HorizontalAlignment="Right" 
                        Background="#FFE81F" 
                        Foreground="Black" 
                        CornerRadius="8" 
                        Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" Foreground="Black"/>
                        <TextBlock Text="Salva Offline" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- INFOBAR PER CONFERMA SALVATAGGIO -->
            <InfoBar x:Name="InfoBarNotifica" 
                     Severity="Success" 
                     Title="Archiviato!" 
                     Message="Film salvato con successo nel database offline." 
                     IsOpen="False" 
                     Margin="0,-12,0,0"/>
            <Grid ColumnSpacing="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Colonna Sinistra: Intestazione e Carte Categoria -->
                <StackPanel Grid.Column="0" Spacing="24">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="NameTextBlock" FontSize="32" FontWeight="Bold" Foreground="#FFE81F" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ModelTextBlock" FontSize="16" Foreground="Gray"/>
                        <TextBlock x:Name="ManufacturerClassTextBlock" FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                        
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Esplora Dati Correlati" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>

                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card / Bottone Piloti -->
                            <Button Grid.Column="0" 
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch" 
                                    Padding="20" 
                                    Background="#1F1F1F" 
                                    CornerRadius="12" 
                                    Click="PilotiCategory_Click">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE77B;" FontSize="36" Foreground="#FFE81F"/>
                                    <TextBlock Text="Piloti" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PilotiCountText" Text="0 elementi" Foreground="Gray" FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Card / Bottone Film -->
                            <Button Grid.Column="1" 
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch" 
                                    Padding="20" 
                                    Background="#1F1F1F" 
                                    CornerRadius="12" 
                                    Click="FilmCategory_Click">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE714;" FontSize="36" Foreground="#FFE81F"/>
                                    <TextBlock Text="Film" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="FilmCountText" Text="0 elementi" Foreground="Gray" FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Colonna Destra: Scheda Dettagli Tecnici -->
                <Border Grid.Column="1" Background="#1A1A1A" Padding="18" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <TextBlock Text="SPECIFICHE TECNICHE E CAPACITÀ" FontWeight="Bold" Foreground="#FFE81F" FontSize="12"/>
                        <TextBlock x:Name="SpecsTextBlock" FontSize="15" Foreground="#FFFFFF" TextWrapping="Wrap" LineHeight="22"/>
                        <TextBlock x:Name="CrewPassengersTextBlock" FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap" LineHeight="20"/>
                    
                        <!-- Prestazioni -->
                        <TextBlock x:Name="SpeedTextBlock" FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                        <TextBlock x:Name="HyperdriveMgltTextBlock" FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap"/>

                        <!-- Capacità e Autonomia -->
                        <TextBlock x:Name="CargoConsumablesTextBlock" FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>