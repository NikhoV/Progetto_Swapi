<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Progetto2.Views.VeicoliPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Progetto2.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
            Text="Dati dei veicoli:"
            FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi"
            FontWeight="Bold"
            FontSize="28"
            Height="64"
            VerticalAlignment="Center"
            Margin="4,12"/>

        <TextBlock Grid.Row="1"
            Margin="2,0,2,12"
            HorizontalAlignment="Stretch"
            Text="Qui puoi trovare informazioni sui veicoli della saga di Star Wars. Puoi cercare i veicoli per nome."
            TextWrapping="Wrap"
            FontSize="16"/>

        <TextBox x:Name="SearchTextBox"
            Grid.Row="2"
            Margin="2,0,2,12"
            MinHeight="40"
            HorizontalAlignment="Stretch"
            PlaceholderText="Nome del Veicolo:"
            TextChanged="SearchTextBox_TextChanged"
            FontSize="16"/>

        <TextBlock  x:Name="MessageTextBlock" Grid.Row="3"
            Margin="2,0,2,12"
            HorizontalAlignment="Stretch"
            Text=""
            TextWrapping="Wrap"
            FontSize="20"
            FontWeight="Bold"
            Visibility="Collapsed"/>

        <ListView x:Name="VeicoliListView" Grid.Row="4" IsItemClickEnabled="True" ItemClick="VeicoliListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,16" Padding="16" Background="#1F1F1F" CornerRadius="8">
                        <!-- Nome del veicolo -->
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="#FFE81F" Margin="0,0,0,4"/>

                        <!-- Modello, Produttore e Classe -->
                        <TextBlock Text="{Binding InfoModello}" Foreground="Gray" FontSize="14" Margin="0,0,0,4"/>

                        <!-- Specifiche tecniche e Costo -->
                        <TextBlock Text="{Binding InfoSpecifiche}" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,10"/>

                        <!-- Conteggi piloti e film -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding PilotiCount}" FontSize="12" Foreground="DarkGray"/>
                            <TextBlock Text="{Binding FilmCount}" FontSize="12" Foreground="DarkGray"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>