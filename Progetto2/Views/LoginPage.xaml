<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Progetto2.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0A0A0A">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Scheda Centrale di Login -->
        <Border Background="#161616" 
                BorderBrush="#FFE81F" 
                BorderThickness="2" 
                CornerRadius="16" 
                Padding="32" 
                Width="380" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <StackPanel Spacing="16">
                <!-- Titolo Star Wars -->
                <TextBlock Text="star wars" 
                           FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi" 
                           FontSize="36" 
                           Foreground="#FFE81F" 
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Accesso al Database Holocron" 
                           FontSize="14" 
                           Foreground="#AAAAAA" 
                           HorizontalAlignment="Center" 
                           Margin="0,-10,0,8"/>

                <TextBox x:Name="TxtUsername" 
                         Header="Nome Utente / Pilota" 
                         PlaceholderText="Inserisci username"
                         Foreground="White"/>

                <PasswordBox x:Name="TxtPassword" 
                             Header="Codice di Accesso" 
                             PlaceholderText="Inserisci password"
                             Foreground="White"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnLogin" Grid.Column="0" 
                            Content="Accedi" 
                            Click="BtnLogin_Click" 
                            HorizontalAlignment="Stretch"
                            Background="#FFE81F" 
                            Foreground="Black" 
                            FontWeight="Bold" 
                            CornerRadius="8"/>

                    <Button x:Name="BtnRegister" Grid.Column="2" 
                            Content="Registrati" 
                            Click="BtnRegister_Click" 
                            HorizontalAlignment="Stretch"
                            Background="#222222" 
                            Foreground="#FFE81F" 
                            BorderBrush="#FFE81F" 
                            BorderThickness="1" 
                            CornerRadius="8"/>
                </Grid>

                <TextBlock x:Name="TxtError" 
                           Foreground="#FF5555" 
                           TextWrapping="Wrap" 
                           HorizontalAlignment="Center" 
                           FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>