<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Progetto2.Views.FilmsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Progetto2.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
            Text="Dati a riguardo dei Film: "
            FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi"
            FontWeight="Bold"
            FontSize="28"
            Height="64"
            VerticalAlignment="Center"
            Margin="4,12"/>
        
        <TextBlock Grid.Row="1"
            Margin="2"
            MinHeight="40"
            HorizontalAlignment="Stretch"
            Text="Qui puoi trovare informazioni sui film della saga di Star Wars. Puoi cercare i film in base al titolo titolo."
            TextWrapping="Wrap"
            FontSize="16"/>

        <TextBox Grid.Row="2"
            x:Name="SearchTextBox"
            Margin="2"
            MinHeight="40"
            HorizontalAlignment="Stretch"
            PlaceholderForeground="White"
            PlaceholderText="Nome del Film:"
            TextWrapping="Wrap"
            TextChanged="SearchTextBox_TextChanged"
            FontSize="16"/>

        <TextBlock  x:Name="MessageTextBlock" Grid.Row="3"
            Margin="2,0,2,12"
            HorizontalAlignment="Stretch"
            Text=""
            TextWrapping="Wrap"
            FontSize="20"
            FontWeight="Bold"
            Visibility="Collapsed"/>

        <ListView x:Name="FilmsListView" Grid.Row="4" IsItemClickEnabled="True" 
          ItemClick="FilmListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,16" Padding="16" Background="#1F1F1F" CornerRadius="8">
                        <!-- Intestazione: Episodio e Titolo -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Episodio " FontSize="18" FontWeight="Bold" Foreground="#FFE81F"/>
                            <TextBlock Text="{Binding EpisodeId}" FontSize="18" FontWeight="Bold" Foreground="#FFE81F"/>
                            <TextBlock Text=" - " FontSize="18" FontWeight="Bold" Foreground="#FFE81F"/>
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#FFE81F"/>
                        </StackPanel>

                        <!-- Regia e Data -->
                        <TextBlock Text="{Binding InfoRegiaData}" Foreground="Gray" FontSize="14" Margin="0,0,0,8"/>

                        <!-- Opening Crawl -->
                        <TextBlock Text="Opening Crawl:" FontWeight="Bold" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding OpeningCrawl}" TextWrapping="Wrap" FontStyle="Italic" Foreground="#CCCCCC" Margin="0,0,0,10"/>

                        <!-- Conteggi Liste correlati -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding PersonaggiCount}" FontSize="12" Foreground="DarkGray"/>
                            <TextBlock Text="{Binding PianetiCount}" FontSize="12" Foreground="DarkGray"/>
                            <TextBlock Text="{Binding NavicelleCount}" FontSize="12" Foreground="DarkGray"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
