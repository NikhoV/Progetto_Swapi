<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Progetto2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Progetto2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SWAPI Holocron App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Header Utente (Nascosta se non loggato) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Pulsanti Categorie (Nascosti se non loggato) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Frame per le Pagine (A tutto schermo se non loggato) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER UTENTE E SEZIONE OFFLINE -->
        <Grid x:Name="UserHeaderGrid" Grid.Row="0" Background="#111111" Padding="16,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nome Utente Loggato -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="Pilota:" 
                           FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi" 
                           Foreground="#FFE81F" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtUsernameHeader" 
                           Text="Utente" 
                           Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Pulsanti Archivio Offline e Logout -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="BtnOfflineSection" 
                        Click="BtnOfflineSection_Click" 
                        Background="#FFE81F" Foreground="Black" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE753;" Foreground="Black"/>
                        <TextBlock Text="Archivio Offline" 
                                   FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi" 
                                   FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnLogout" 
                        Click="BtnLogout_Click" 
                        Background="#333333" Foreground="LightCoral" CornerRadius="8" Padding="12,6">
                    <TextBlock Text="Esci" FontWeight="Bold" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- PANNELLO CATEGORIE STAR WARS -->
        <ScrollViewer x:Name="CategoriesPanel" Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Disabled"
                      Visibility="Collapsed">
            <Grid Padding="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Background="Yellow" CornerRadius="12" Margin="4" MinHeight="60"
                        HorizontalAlignment="Stretch" Click="BtnCategoria_Click" Tag="Films">
                    <TextBlock Text="Films" FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi" FontSize="18" Foreground="Black" FontWeight="Bold"/>
                </Button>
                <Button Grid.Column="1" Background="Yellow" CornerRadius="12" Margin="4" MinHeight="60"
                        HorizontalAlignment="Stretch" Click="BtnCategoria_Click" Tag="Personaggi">
                    <TextBlock Text="Personaggi" FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi" FontSize="18" Foreground="Black" FontWeight="Bold"/>
                </Button>
                <Button Grid.Column="2" Background="Yellow" CornerRadius="12" Margin="4" MinHeight="60"
                        HorizontalAlignment="Stretch" Click="BtnCategoria_Click" Tag="Pianeti">
                    <TextBlock Text="Pianeti" FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi" FontSize="18" Foreground="Black" FontWeight="Bold"/>
                </Button>
                <Button Grid.Column="3" Background="Yellow" CornerRadius="12" Margin="4" MinHeight="60"
                        HorizontalAlignment="Stretch" Click="BtnCategoria_Click" Tag="Navicelle">
                    <TextBlock Text="Navicelle" FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi" FontSize="18" Foreground="Black" FontWeight="Bold"/>
                </Button>
                <Button Grid.Column="4" Background="Yellow" CornerRadius="12" Margin="4" MinHeight="60"
                        HorizontalAlignment="Stretch" Click="BtnCategoria_Click" Tag="Veicoli">
                    <TextBlock Text="veicoli" FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi" FontSize="18" Foreground="Black" FontWeight="Bold"/>
                </Button>
                <Button Grid.Column="5" Background="Yellow" CornerRadius="12" Margin="4" MinHeight="60"
                        HorizontalAlignment="Stretch" Click="BtnCategoria_Click" Tag="Specie">
                    <TextBlock Text="specie" FontFamily="ms-appx:///Assets/Fonts/Starjedi.ttf#Star Jedi" FontSize="18" Foreground="Black" FontWeight="Bold"/>
                </Button>
            </Grid>
        </ScrollViewer>

        <!-- FRAME PRINCIPALE -->
        <Frame x:Name="RootFrame" Grid.Row="2" Margin="0"/>
    </Grid>
</Window>